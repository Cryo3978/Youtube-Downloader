# =============================================================================
# YouTube Downloader — environment variable template
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your local paths and credentials
#
# WARNING: Never commit .env to git — it may contain secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Paths & storage (shared by collect_meta.py and download_from_meta.py)
# -----------------------------------------------------------------------------

# Local working directory for metadata, downloads, and archive files
SAVE_ROOT=./data

# Path to YouTube cookies file (Netscape format)
COOKIE_PATH=./youtube_cookies.txt

# Metadata JSON path (default: {SAVE_ROOT}/metadata.json)
# META_PATH=./data/metadata.json

# Download archive file (default: {SAVE_ROOT}/_downloaded_global.txt)
# GLOBAL_ARCHIVE=./data/_downloaded_global.txt

# -----------------------------------------------------------------------------
# Metadata collection (collect_meta.py)
# -----------------------------------------------------------------------------

# Max videos to fetch per keyword (ytsearch limit)
MAX_RESULTS=3000

# Seconds to wait between keyword searches (reduces rate-limit risk)
COLLECT_SLEEP_SECONDS=5

# yt-dlp player client for collection (default: tv_embedded)
# YTDLP_COLLECT_PLAYER_CLIENT=tv_embedded

# -----------------------------------------------------------------------------
# Video download (download_from_meta.py)
# -----------------------------------------------------------------------------

# PO Token for yt-dlp android client (optional; set when downloads fail)
PO_TOKEN=

# Max download attempts per video
RETRY_LIMIT=2

# Sleep interval between download requests (seconds)
DOWNLOAD_SLEEP_INTERVAL=3
DOWNLOAD_MAX_SLEEP_INTERVAL=6

# Wait time when rate-limited (seconds)
RATE_LIMIT_SLEEP_SECONDS=120

# yt-dlp player clients for download (default: tv_embedded,android)
# YTDLP_DOWNLOAD_PLAYER_CLIENT=tv_embedded,android

# Video format selection
# DOWNLOAD_FORMAT=bestvideo+bestaudio/best
# MERGE_OUTPUT_FORMAT=mp4

# -----------------------------------------------------------------------------
# Remote sync via rsync (optional — leave REMOTE_* empty for local-only use)
# -----------------------------------------------------------------------------

# Absolute path to SSH private key, e.g. /Users/you/.ssh/id_ed25519
SSH_KEY=

# Remote server username
REMOTE_USER=

# Remote server host (IP or hostname)
REMOTE_HOST=

# Remote destination directory (must exist and be writable)
REMOTE_DIR=

# Trigger rsync after every N successful downloads
SYNC_INTERVAL=10

# Seconds to wait after each rsync batch
SYNC_POST_SLEEP_SECONDS=30

# SSH options (prefer accept-new over disabling host key checking)
# SSH_OPTIONS=-o StrictHostKeyChecking=accept-new

# Delete local .mp4 files after a successful rsync (true / false)
DELETE_LOCAL_AFTER_RSYNC=true
